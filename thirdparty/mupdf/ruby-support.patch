+static void draw_ruby(fz_context *ctx, fz_html_box *ruby, fz_device *dev, fz_matrix ctm,
+	hb_buffer_t *hb_buf, fz_html_flow *flow, float dx, float dy, float page_top)
+{
+	int skip_annotations = (dev->hints & FZ_IGNORE_RUBY_ANNOTATIONS) != 0;
+
+	for (; flow; flow = flow->next)
+	{
+		const fz_css_style *style = flow->box->style;
+
+		if (style->visibility != V_VISIBLE)
+			continue;
+
+		if (skip_annotations && flow_is_ruby_annotation(flow))
+			continue;
+
+		if (flow->type == FLOW_RUBY)
+		{
+			/* Nested ruby: recurse with the inner offsets added. */
+			draw_ruby(ctx, flow->box, dev, ctm, hb_buf,
+				flow->box->u.flow.head, dx + flow->x, dy + flow->y, page_top);
+			continue;
+		}
+
+		if (flow->type != FLOW_WORD && flow->type != FLOW_SPACE && flow->type != FLOW_SHYPHEN)
+			continue;
+
+		{
+			string_walker walker;
+			fz_css_color color;
+			fz_text *text;
+			fz_matrix trm;
+			const char *s;
+			float em, x, y;
+			unpacked_color unpacked;
+
+			em = flow->box->s.layout.em;
+			if (flow->bidi_level & 1)
+				x = dx + flow->x + flow->w;
+			else
+				x = dx + flow->x;
+			y = dy + flow->y;
+
+			s = get_node_text(ctx, flow);
+			text = fz_new_text(ctx);
+
+			trm.a = em;
+			trm.b = 0;
+			trm.c = 0;
+			trm.d = -em;
+			trm.e = x;
+			trm.f = y - page_top;
+
+			init_string_walker(ctx, &walker, hb_buf, flow->bidi_level & 1, style->font, flow->script, flow->markup_lang, style->small_caps, s, 0);
+			while (walk_string(&walker))
+			{
+				float node_scale = flow->box->s.layout.em / walker.scale;
+				unsigned int i;
+				uint32_t k;
+				int c, n;
+
+				/* Flatten advance and offset into offset array. */
+				int x_advance = 0;
+				int y_advance = 0;
+				for (i = 0; i < walker.glyph_count; ++i)
+				{
+					walker.glyph_pos[i].x_offset += x_advance;
+					walker.glyph_pos[i].y_offset += y_advance;
+					x_advance += walker.glyph_pos[i].x_advance;
+					y_advance += walker.glyph_pos[i].y_advance;
+				}
+
+				if (flow->bidi_level & 1)
+					x -= x_advance * node_scale;
+
+				/* Walk characters to find glyph clusters */
+				k = 0;
+				while (walker.start + k < walker.end)
+				{
+					n = fz_chartorune(&c, walker.start + k);
+
+					for (i = 0; i < walker.glyph_count; ++i)
+					{
+						if (walker.glyph_info[i].cluster == k)
+						{
+							trm.e = x + walker.glyph_pos[i].x_offset * node_scale;
+							trm.f = y - walker.glyph_pos[i].y_offset * node_scale - page_top;
+							fz_show_glyph(ctx, text, walker.font, trm,
+									walker.glyph_info[i].codepoint, c,
+									0, flow->bidi_level, ruby->markup_dir, flow->markup_lang);
+							c = -1; /* for subsequent glyphs in x-to-many mappings */
+						}
+					}
