+					/* no glyph found (many-to-many or many-to-one mapping) */
+					if (c != -1)
+					{
+						fz_show_glyph(ctx, text, walker.font, trm,
+								-1, c,
+								0, flow->bidi_level, ruby->markup_dir, flow->markup_lang);
+					}
+
+					k += n;
+				}
+
+				if ((flow->bidi_level & 1) == 0)
+					x += x_advance * node_scale;
+
+				y += y_advance * node_scale;
+			}
+
+			color = style->text_fill_color.a != 0 ? style->text_fill_color : style->color;
+			unpacked = unpack_color(color);
+			fz_fill_text(ctx, dev, text, ctm, fz_device_rgb(ctx), unpacked.rgb, unpacked.a, fz_default_color_params);
+			fz_drop_text(ctx, text);
+		}
+	}
+}
