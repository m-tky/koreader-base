+/* A flow belongs to the annotation part of its ruby box if it is inside an
+ * <rt> or <rtc> element (directly or through other inline markup). */
+static int flow_is_ruby_annotation(fz_html_flow *flow)
+{
+	fz_html_box *box = flow->box;
+	while (box && box->type != BOX_RUBY && box->type != BOX_FLOW)
+	{
+		if (box->tag && (!strcmp(box->tag, "rt") || !strcmp(box->tag, "rtc")))
+			return 1;
+		box = box->up;
+	}
+	return 0;
+}
+
+/* Lay out a ruby box: pair each run of annotation words with the preceding
+ * run of base words, centered above it. An annotation wider than its base
+ * widens the segment so both fit.
+ *
+ * Inner flow positions are relative to the top of the ruby unit (the
+ * FLOW_RUBY node's origin). The node's w and h are set here, and the box's
+ * layout baseline stores the (negative) offset from the node's origin to
+ * the base text baseline. Uses the fonts' real ascender/descender metrics
+ * so glyphs neither overlap nor float. */
+static void layout_ruby(fz_context *ctx, fz_html_flow *node)
+{
+	fz_html_box *ruby = node->box;
+	fz_html_flow *flow, *base, *base_end, *ann, *ann_end;
+	fz_font *base_font = NULL;
+	fz_font *ann_font = NULL;
+	float base_em = ruby->s.layout.em;
+	float ann_em = base_em * 0.5f;
+	float base_asc = 0.8f, base_desc = 0.2f;
+	float ann_asc = 0.8f, ann_desc = 0.2f;
+	float base_baseline, ann_baseline;
+	float x = 0;
+	int has_ann = 0;
+
+	/* Find any annotation (with its em size and font), and the base font. */
+	for (flow = ruby->u.flow.head; flow; flow = flow->next)
+	{
+		if (flow_is_ruby_annotation(flow))
+		{
+			if (ann_font == NULL)
+			{
+				ann_font = flow->box->style->font;
+				ann_em = flow->box->s.layout.em;
+			}
+			has_ann = 1;
+			break;
+		}
+		else if (base_font == NULL && flow->type == FLOW_WORD)
+		{
+			base_font = flow->box->style->font;
+		}
+	}
+	if (base_font == NULL)
+		base_font = ruby->style->font;
+
+	/* Use the real font metrics. */
+	if (base_font)
+	{
+		base_asc = fz_font_ascender(ctx, base_font);
+		base_desc = -fz_font_descender(ctx, base_font);
+	}
+	if (ann_font)
+	{
+		ann_asc = fz_font_ascender(ctx, ann_font);
+		ann_desc = -fz_font_descender(ctx, ann_font);
+	}
+
+	/* Annotation at the top, base text below it. */
+	if (has_ann)
+	{
+		ann_baseline = ann_asc * ann_em;
+		base_baseline = (ann_asc + ann_desc) * ann_em + base_asc * base_em;
+	}
+	else
+	{
+		ann_baseline = 0;
+		base_baseline = base_asc * base_em;
+	}
+	ruby->s.layout.baseline = -base_baseline;
+
+	flow = ruby->u.flow.head;
+	while (flow)
+	{
+		float base_w = 0, ann_w = 0;
+		float seg_w, base_x, ann_x;
+
+		/* Collect the base run. */
+		base = flow;
+		while (flow && !flow_is_ruby_annotation(flow))
+		{
+			if (flow->type != FLOW_SBREAK && flow->type != FLOW_SHYPHEN)
+				base_w += flow->w;
+			flow = flow->next;
+		}
+		base_end = flow;
+
+		/* Collect the annotation run (if any). */
+		ann = flow;
+		while (flow && flow_is_ruby_annotation(flow))
+		{
+			ann_w += flow->w;
+			flow = flow->next;
+		}
+		ann_end = flow;
+
+		if (ann_w > 0 && base_w > 0)
+		{
+			seg_w = fz_max(base_w, ann_w);
+			base_x = x + (seg_w - base_w) / 2;
+			ann_x = x + (seg_w - ann_w) / 2;
+		}
+		else if (ann_w > 0)
+		{
+			/* Annotation without any base text: keep it inline. */
+			seg_w = ann_w;
+			base_x = 0;
+			ann_x = x;
+		}
+		else
+		{
+			seg_w = base_w;
+			base_x = x;
+			ann_x = 0;
+		}
+
+		/* Place the base and annotation words; y is the text baseline,
+		 * relative to the ruby box origin. */
+		{
+			float bx = base_x;
+			for (flow = base; flow != base_end; flow = flow->next)
+			{
+				if (flow->type == FLOW_SBREAK || flow->type == FLOW_SHYPHEN)
+					continue;
+				flow->x = bx;
+				flow->y = base_baseline;
+				bx += flow->w;
+			}
+		}
+		{
+			float ax = ann_x;
+			for (flow = ann; flow != ann_end; flow = flow->next)
+			{
+				flow->x = ax;
+				flow->y = ann_baseline;
+				ax += flow->w;
+			}
+		}
+
+		x += seg_w;
+		flow = ann_end;
+	}
+
+	node->w = x;
+	if (has_ann)
+	{
+		/* Annotation and base text heights. */
+		node->h = (ann_asc + ann_desc) * ann_em
+			+ (base_asc + base_desc) * base_em;
+	}
+	else
+	{
+		/* Degenerate ruby without annotations: behave like plain text. */
+		node->h = (base_asc + base_desc) * base_em;
+	}
+}
